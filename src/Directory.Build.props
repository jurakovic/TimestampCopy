<Project>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Required by the LibraryImport source generator (MessageBoxW) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Runs the Native AOT analyzers on every build, and with TreatWarningsAsErrors anything
         AOT cannot compile fails it. The two executables set PublishAot themselves. -->
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseWPF>false</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The version of local builds. Releases override it with the version publish.sh
         computes from the git tags. -->
    <Version>3.0.0</Version>
    <!-- Keeps the version a plain 3.0.0 instead of 3.0.0+<commit hash>, so tscp -v prints
         exactly the version publish.sh released it as -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Timestamp Copy</Product>
    <Company>jurakovic</Company>
    <Copyright>Copyright (c) jurakovic</Copyright>
    <RepositoryUrl>https://github.com/jurakovic/TimestampCopy</RepositoryUrl>
  </PropertyGroup>

</Project>
